# Copy to .env; replace placeholders with your own credentials.
# Set the key for your selected LLM provider and select matching models in CLI/config.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Optional services (not required for ordinary A-share quotes).
ALPHA_VANTAGE_API_KEY=
IWENCAI_API_KEY=
XUEQIU_COOKIE=

# Optional local state paths; omit to use project/.tradingagents.
# TRADINGAGENTS_HOME=/path/to/local-state
# TRADINGAGENTS_RESULTS_DIR=/path/to/reports
# TRADINGAGENTS_CACHE_DIR=/path/to/cache
# TRADINGAGENTS_MEMORY_LOG_PATH=/path/to/trading_memory.md
# Docker Compose persistent volume:
# TRADINGAGENTS_HOME=/home/appuser/.tradingagents
